# Copy this file to .env for local development. Never commit .env.
# Run the API from the backend/ directory so relative SQLite paths resolve.

APP_ENV=dev

# SQLite (default). For AWS RDS PostgreSQL later, use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./employee_management_dev.db

# Development placeholder only. Use a long random value in any non-dev environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array. Expo web and local API hosts used during development.
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
