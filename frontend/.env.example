# Copy this file to .env for local development. Never commit .env.
# Expo inlines EXPO_PUBLIC_* variables at build time; restart `npx expo start` after changes.

# Backend API base URL, without a trailing slash.
# Web on this machine: http://localhost:8000/api/v1
# Phone or emulator: use this machine's LAN IP (for example http://192.168.1.20:8000/api/v1)
# and start the backend with --host 0.0.0.0. Required for release builds.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
